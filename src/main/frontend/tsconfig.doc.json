/* TypeScript configuration for documentation generation */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": false,
    "stripInternal": false,
    "outDir": "./docs/typedoc",
    "moduleResolution": "node"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/test-setup.ts",
    "src/main.ts",
    "node_modules"
  ]
}
